{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "minio/mc/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 5,
    "startupBehavior": {
      "type": "ONESHOT"
    },
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": 0
  }
}
