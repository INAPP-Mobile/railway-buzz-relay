{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "relay/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/_readiness",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "volumeMounts": [
      {
        "name": "buzz-git-data",
        "mountPath": "/data/git"
      }
    ]
  }
}